# Plantilla de variables de entorno de GestorCar.
# Cópiala como .env (cp .env.example .env) y ajusta los valores si hace falta.
# El archivo .env no se sube al repositorio.

# Clave secreta de Django. Obligatoria. En desarrollo sirve este valor; en
# cualquier otro entorno genera una nueva y no la compartas.
SECRET_KEY=clave-de-desarrollo-no-usar-en-produccion

# Modo de depuración. True solo en desarrollo; si no se define, es False.
DEBUG=True

# Hosts que pueden servir la aplicación, separados por comas.
ALLOWED_HOSTS=localhost,127.0.0.1

# Zona horaria con la que se muestran las fechas (se guardan en UTC).
TIME_ZONE=UTC

# Credenciales de PostgreSQL que usa el contenedor de base de datos.
POSTGRES_DB=gestorcar
POSTGRES_USER=gestorcar
POSTGRES_PASSWORD=gestorcar

# Puerto del equipo donde se publica PostgreSQL. Cámbialo si el 5432 ya está ocupado.
DB_PORT=5432

# Conexión a la base de datos para ejecutar Django fuera de Docker (.venv local).
# Dentro de Docker, docker-compose la reemplaza para usar el servicio "db".
DATABASE_URL=postgres://gestorcar:gestorcar@localhost:5432/gestorcar
